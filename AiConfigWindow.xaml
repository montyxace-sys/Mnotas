<Window x:Class="Mnotas.AiConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="Configurar IA" Height="300" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource FgBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Configuración de Inteligencia Artificial" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- API Key -->
        <TextBlock Grid.Row="0" Text="API Key:" Margin="0,0,0,8"/>
        <TextBox x:Name="ApiKeyTextBox" Grid.Row="0" Height="30" Margin="0,0,0,16" 
                 Text="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Model -->
        <TextBlock Grid.Row="1" Text="Modelo:" Margin="0,0,0,8"/>
        <ComboBox x:Name="ModelComboBox" Grid.Row="1" Height="30" Margin="0,0,0,16">
            <ComboBoxItem Content="deepseek-chat" IsSelected="True"/>
            <ComboBoxItem Content="deepseek-coder"/>
            <ComboBoxItem Content="deepseek-v3"/>
        </ComboBox>

        <!-- Endpoint -->
        <TextBlock Grid.Row="2" Text="Endpoint:" Margin="0,0,0,8"/>
        <TextBox x:Name="EndpointTextBox" Grid.Row="2" Height="30" Margin="0,0,0,16" 
                 Text="{Binding Endpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        
        <TextBlock Grid.Row="2" Text="(dejar vacío para usar el endpoint default)" FontSize="10" Foreground="{DynamicResource FgBrush}" Opacity="0.6" Margin="0,0,0,4"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Guardar" Click="Save_Click" Width="80" Height="30" Margin="0,0,10,0"/>
            <Button Content="Cancelar" Click="Cancel_Click" Width="80" Height="30"/>
        </StackPanel>
    </Grid>
</Window>