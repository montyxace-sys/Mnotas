<Window x:Class="Mnotas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Mnotas" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        Icon="Mnotas.ico"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource FgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{DynamicResource BgAltBrush}" Padding="12,8">
            <Grid>
                <TextBlock Text="Mnotas" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Nuevo" Click="New_Click" Margin="0,0,4,0"/>
                    <Button Content="Abrir" Click="Open_Click" Margin="0,0,4,0"/>
                    <Button Content="Guardar" Click="Save_Click" Margin="0,0,4,0"/>
                    <Button Content="Buscar" Click="Find_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Menu -->
        <Menu Grid.Row="1" Background="{DynamicResource BgBrush}">
            <MenuItem Header="Archivo">
                <MenuItem Header="Nuevo" InputGestureText="Ctrl+N" Click="New_Click"/>
                <MenuItem Header="Abrir..." InputGestureText="Ctrl+O" Click="Open_Click"/>
                <MenuItem Header="Guardar" InputGestureText="Ctrl+S" Click="Save_Click"/>
                <MenuItem Header="Guardar como..." Click="SaveAs_Click"/>
                <Separator/>
                <MenuItem Header="Cerrar pestaña" Click="CloseTab_Click"/>
                <Separator/>
                <MenuItem Header="Salir" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Editar">
                <MenuItem Header="Deshacer" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
                <MenuItem Header="Rehacer" InputGestureText="Ctrl+Y" Click="Redo_Click"/>
                <Separator/>
                <MenuItem Header="Cortar" InputGestureText="Ctrl+X" Click="Cut_Click"/>
                <MenuItem Header="Copiar" InputGestureText="Ctrl+C" Click="Copy_Click"/>
                <MenuItem Header="Pegar" InputGestureText="Ctrl+V" Click="Paste_Click"/>
                <Separator/>
                <MenuItem Header="Buscar..." InputGestureText="Ctrl+F" Click="Find_Click"/>
                <MenuItem Header="Reemplazar..." InputGestureText="Ctrl+H" Click="Replace_Click"/>
            </MenuItem>
            <MenuItem Header="Ver">
                <MenuItem Header="Números de línea" IsCheckable="True" IsChecked="True" Click="ToggleLineNumbers_Click"/>
                <MenuItem Header="Ajuste de línea" IsCheckable="True" Click="ToggleWordWrap_Click"/>
                <Separator/>
                <MenuItem Header="Tema claro" Click="ThemeLight_Click"/>
                <MenuItem Header="Tema oscuro" Click="ThemeDark_Click"/>
                <Separator/>
                <MenuItem Header="Acercar" InputGestureText="Ctrl++" Click="ZoomIn_Click"/>
                <MenuItem Header="Alejar" InputGestureText="Ctrl+-" Click="ZoomOut_Click"/>
            </MenuItem>
            <MenuItem Header="Lenguaje">
                <MenuItem Header="Texto plano" Click="Lang_Click" Tag="Text"/>
                <MenuItem Header="C#" Click="Lang_Click" Tag="C#"/>
                <MenuItem Header="JavaScript" Click="Lang_Click" Tag="JavaScript"/>
                <MenuItem Header="Python" Click="Lang_Click" Tag="Python"/>
                <MenuItem Header="HTML" Click="Lang_Click" Tag="HTML"/>
                <MenuItem Header="CSS" Click="Lang_Click" Tag="CSS"/>
                <MenuItem Header="JSON" Click="Lang_Click" Tag="JSON"/>
                <MenuItem Header="XML" Click="Lang_Click" Tag="XML"/>
                <MenuItem Header="SQL" Click="Lang_Click" Tag="SQL"/>
                <MenuItem Header="Markdown" Click="Lang_Click" Tag="Markdown"/>
            </MenuItem>
        </Menu>

        <!-- Tabs + Editor -->
        <TabControl Grid.Row="2" x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
        </TabControl>

        <!-- Status bar -->
        <StatusBar Grid.Row="3" Background="{DynamicResource BgAltBrush}">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Listo"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="PositionText" Text="Ln 1, Col 1"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right" Margin="12,0,0,0">
                <TextBlock x:Name="EncodingText" Text="UTF-8"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
