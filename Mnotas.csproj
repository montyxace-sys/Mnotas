<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Mnotas.ico</ApplicationIcon>
    <AssemblyName>Mnotas</AssemblyName>
    <RootNamespace>Mnotas</RootNamespace>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Mnotas.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="obj\**\*.cs" />
    <Compile Remove="bin\**\*.cs" />
    <Compile Remove="**\obj\**\*.cs" />
    <Compile Remove="**\bin\**\*.cs" />
    <Compile Remove="Core\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="Mnotas.Cli\**\*.cs" />
    <Compile Remove="Mnotas.Desktop\**\*.cs" />
    <Compile Remove="Mnotas.Portable.App\**\*.cs" />
    <Compile Remove="Mnotas.Android\**\*.cs" />
    <Compile Remove="Mnotas.iOS\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Core\Mnotas.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.161" />
  </ItemGroup>

</Project>
